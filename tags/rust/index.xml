<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Rust on 人心如花木，皆向阳而生</title><link>https://imhun.com/tags/rust/</link><description>Recent content in Rust on 人心如花木，皆向阳而生</description><generator>Hugo</generator><language>en</language><lastBuildDate>Thu, 01 Oct 2026 19:43:55 +0800</lastBuildDate><atom:link href="https://imhun.com/tags/rust/index.xml" rel="self" type="application/rss+xml"/><item><title>Ctfe 编译时函数求值</title><link>https://imhun.com/post/2018-07-20.ctfe-compile-time-eval/</link><pubDate>Fri, 20 Jul 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-07-20.ctfe-compile-time-eval/</guid><description>&lt;p&gt;Ctfe 编译时函数求值&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="no"&gt;CTFE&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;must&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;be&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;deterministic&lt;/span&gt;&lt;span class="p"&gt;.&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="err"&gt;必须是确定性的&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;any kind of external input and any kind of non-determinism is a complete no-go for CTFE&lt;/p&gt;&#10;&lt;p&gt;ctfe完全不接受任何外部输入和任何非确定性&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;span class="lnt"&gt;2&#10;&lt;/span&gt;&lt;span class="lnt"&gt;3&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;A&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;program&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;is&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;const&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;safe&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;if&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;it&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;can&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;be&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;executed&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;by&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="no"&gt;CTFE&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;without&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;hitting&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;an&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;error&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;A&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;function&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;is&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;const&lt;/span&gt;&lt;span class="o"&gt;-&lt;/span&gt;&lt;span class="n"&gt;safe&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;if&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;when&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;executed&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;with&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;const&lt;/span&gt;&lt;span class="o"&gt;-&lt;/span&gt;&lt;span class="n"&gt;valid&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;arguments&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;it&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;does&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;not&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;trigger&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;a&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="no"&gt;CTFE&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;error&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;and&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;returns&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;a&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;const&lt;/span&gt;&lt;span class="o"&gt;-&lt;/span&gt;&lt;span class="n"&gt;valid&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;result&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="k"&gt;if&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;it&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;returns&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;at&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;all&lt;/span&gt;&lt;span class="p"&gt;).&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="no"&gt;CTFE&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;is&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;correct&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="k"&gt;if&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;when&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;it&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;loops&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;forever&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;completes&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;with&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;a&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;result&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;or&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;panics&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;that&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;behavior&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;matches&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;the&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;run&lt;/span&gt;&lt;span class="o"&gt;-&lt;/span&gt;&lt;span class="n"&gt;time&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;behavior&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;of&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;the&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;same&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;code&lt;/span&gt;&lt;span class="p"&gt;.&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;</description></item><item><title>Compiler intrinsics</title><link>https://imhun.com/post/2018-05-08.compiler-intrinsics/</link><pubDate>Tue, 08 May 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-05-08.compiler-intrinsics/</guid><description>&lt;p&gt;Compiler intrinsics&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;Intrinsics 为编译器内部功能，需要通过rust-intrinsics ABI来调用，调用时需要当成FFI函数来导入，因此总是unsafe的。&lt;/p&gt;&#10;&lt;p&gt;比如&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;span class="lnt"&gt;2&#10;&lt;/span&gt;&lt;span class="lnt"&gt;3&#10;&lt;/span&gt;&lt;span class="lnt"&gt;4&#10;&lt;/span&gt;&lt;span class="lnt"&gt;5&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;extern&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="s"&gt;&amp;#34;rust-intrinsic&amp;#34;&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;{&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;fn&lt;/span&gt; &lt;span class="nf"&gt;transmute&lt;/span&gt;&lt;span class="o"&gt;&amp;lt;&lt;/span&gt;&lt;span class="n"&gt;T&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;U&lt;/span&gt;&lt;span class="o"&gt;&amp;gt;&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="n"&gt;x&lt;/span&gt;: &lt;span class="nc"&gt;T&lt;/span&gt;&lt;span class="p"&gt;)&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;-&amp;gt; &lt;span class="nc"&gt;U&lt;/span&gt;&lt;span class="p"&gt;;&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;fn&lt;/span&gt; &lt;span class="nf"&gt;offset&lt;/span&gt;&lt;span class="o"&gt;&amp;lt;&lt;/span&gt;&lt;span class="n"&gt;T&lt;/span&gt;&lt;span class="o"&gt;&amp;gt;&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="n"&gt;dst&lt;/span&gt;: &lt;span class="o"&gt;*&lt;/span&gt;&lt;span class="k"&gt;const&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;T&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;offset&lt;/span&gt;: &lt;span class="kt"&gt;isize&lt;/span&gt;&lt;span class="p"&gt;)&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;-&amp;gt; &lt;span class="o"&gt;*&lt;/span&gt;&lt;span class="k"&gt;const&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;T&lt;/span&gt;&lt;span class="p"&gt;;&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;core&lt;/span&gt;::&lt;span class="n"&gt;intrinsics模块就是intrinsics的FFI导入&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;</description></item><item><title>开发练习</title><link>https://imhun.com/post/2018-04-25.rust-dev-practice/</link><pubDate>Wed, 25 Apr 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-04-25.rust-dev-practice/</guid><description>&lt;p&gt;开发练习&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;Webassembly Rust 生命游戏&lt;/p&gt;&#10;&lt;p&gt;有限宇宙策略&lt;/p&gt;&#10;&lt;p&gt;1.跟踪存在事件的宇宙子集，在需要的时候进行扩展。在最坏的情况下，扩展是无限的，将会导致速度变慢，内存不够&lt;/p&gt;&#10;&lt;p&gt;2.创建固定大小的宇宙。在边上的单元的邻居数量少于中间的单元，缺点是有些模式在到达边界时会消失&lt;/p&gt;</description></item><item><title>标准库unsafe</title><link>https://imhun.com/post/2018-03-26.rust-std-unsafe/</link><pubDate>Mon, 26 Mar 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-03-26.rust-std-unsafe/</guid><description>&lt;p&gt;标准库unsafe&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;slice::get_unchecked&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;mem::transmute reinterprets some value as having a given type, bypassing type safety in arbitrary ways&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Every raw pointer to a sized type has an offset method that invokes Undefined Behavior if the passed offset is not &lt;a href="file:///Users/polus/.rustup/toolchains/nightly-x86_64-apple-darwin/share/doc/rust/html/std/primitive.pointer.html#method.offset"&gt;&amp;ldquo;in bounds&amp;rdquo;&lt;/a&gt;.&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;All FFI (Foreign Function Interface) functions are unsafe to call because the other language can do arbitrary operations that the Rust compiler can&amp;rsquo;t check.&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Send is a marker trait (a trait with no API) that promises implementors are safe to send (move) to another thread.&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Sync is a marker trait that promises threads can safely share implementors through a shared reference.&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ul&gt;</description></item><item><title>并发</title><link>https://imhun.com/post/2018-03-25.rust-concurrency/</link><pubDate>Sun, 25 Mar 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-03-25.rust-concurrency/</guid><description>&lt;p&gt;并发&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;共享可变，convar，与一个mutex保护的条件量一起起作用&lt;/p&gt;&#10;&lt;p&gt;wait方法会一直等待，直到子线程调用notify方法&lt;/p&gt;&#10;&lt;p&gt;wait方法接受一个MutexGuard值，消耗掉，并释放锁，然后等待子线程的notify通知，等到通知以后，再次lock并返回一个MutexGuard值&lt;/p&gt;</description></item><item><title>unsafe</title><link>https://imhun.com/post/2018-03-23.rust-unsafe/</link><pubDate>Fri, 23 Mar 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-03-23.rust-unsafe/</guid><description>&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;unsafe&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;!-- more --&gt;&#10;&lt;p&gt;本质上，静态分析是保守的，有时候需要一些代码但rust安全规则不允许，unsafe放开规则的限制，让你自己保证安全性&lt;/p&gt;&#10;&lt;p&gt;计算机底层硬件有内在的不安全性，&lt;/p&gt;</description></item><item><title>Covariance/contravariance</title><link>https://imhun.com/post/2018-03-21.covariance-contravariance/</link><pubDate>Wed, 21 Mar 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-03-21.covariance-contravariance/</guid><description>&lt;p&gt;Covariance/contravariance&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;&lt;img src="covariance-contravariance-01.jpg" alt=""&gt;&lt;/p&gt;</description></item><item><title>macro</title><link>https://imhun.com/post/2018-03-20.rust-macro/</link><pubDate>Tue, 20 Mar 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-03-20.rust-macro/</guid><description>&lt;p&gt;macro&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;1.宏需要声明在前&lt;/p&gt;&#10;&lt;p&gt;不能在宏定义之前调用宏。因为rust会在遇到宏调用的时候直接展开，展开时不会去看宏调用后面的代码&lt;/p&gt;&#10;&lt;p&gt;You can’t call a macro before it is defined, because Rust expands each macro call before it even looks at the rest of the program&lt;/p&gt;</description></item><item><title>trait</title><link>https://imhun.com/post/2018-02-02.rust-trait/</link><pubDate>Fri, 02 Feb 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-02-02.rust-trait/</guid><description>&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;span class="lnt"&gt;2&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;trait&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;trait必须在作用域内&lt;/span&gt;&lt;span class="err"&gt;，通过&lt;/span&gt;&lt;span class="n"&gt;use引入&lt;/span&gt;&lt;span class="err"&gt;，指定要使用的&lt;/span&gt;&lt;span class="n"&gt;traint&lt;/span&gt;&lt;span class="err"&gt;，避免命名冲突&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;!-- more --&gt;&#10;&lt;p&gt;可用使用trait为任何类型添加方法&lt;/p&gt;&#10;&lt;p&gt;Standard prelude 默认引入部分trait&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;trait方法&lt;/span&gt;&lt;span class="err"&gt;，默认采用单态，有可能直接内联&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;使用trait object时才会使用类似c++的虚方法调用&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="n"&gt;trait为unsized类型&lt;/span&gt;&lt;span class="err"&gt;，也即动态大小类型&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;Trait object ,trait 类型的引用，无法在编译时确定具体的类型，不支持downcast到具体类型，为fat pointer。包括一个指向值的指针，以及指向虚表的指针，编译时生成，被同一类型的所有对象共享&lt;/p&gt;</description></item><item><title>Match pattern</title><link>https://imhun.com/post/2018-02-01.rust-match-pattern/</link><pubDate>Thu, 01 Feb 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-02-01.rust-match-pattern/</guid><description>&lt;p&gt;Match pattern&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;表达式产生值，模式消费值&lt;/p&gt;&#10;&lt;p&gt;&lt;img src="rust-match-pattern-01.png" alt=""&gt;&lt;/p&gt;</description></item><item><title>同步异步，阻塞非阻塞</title><link>https://imhun.com/post/2018-01-17.sync-async-blocking/</link><pubDate>Wed, 17 Jan 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-01-17.sync-async-blocking/</guid><description>&lt;p&gt;同步异步，阻塞非阻塞&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;老张爱喝茶，废话不说，煮开水。&lt;/p&gt;&#10;&lt;p&gt;出场人物：老张，水壶两把（普通水壶，简称水壶；会响的水壶，简称响水壶）。&lt;/p&gt;&#10;&lt;p&gt;1 老张把水壶放到火上，立等水开。（同步阻塞）&lt;/p&gt;</description></item><item><title>Ownership,Lifetime</title><link>https://imhun.com/post/2018-01-14.ownership-lifetime/</link><pubDate>Sun, 14 Jan 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-01-14.ownership-lifetime/</guid><description>&lt;p&gt;Ownership,Lifetime&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;&lt;img src="ownership-lifetime-01.png" alt=""&gt;&lt;/p&gt;&#10;&lt;p&gt;变量单所有者规则，变量构成结构为树，不允许比树更复杂的结构&lt;/p&gt;&#10;&lt;p&gt;释放变量：&lt;/p&gt;&#10;&lt;p&gt;1.离开变量作用域&lt;/p&gt;&#10;&lt;p&gt;2.从vector中删除元素，或者类似操作。&lt;/p&gt;&#10;&lt;p&gt;保证变量和其拥有的值正确释放&lt;/p&gt;</description></item><item><title>string</title><link>https://imhun.com/post/2018-01-14.rust-string/</link><pubDate>Sun, 14 Jan 2018 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2018-01-14.rust-string/</guid><description>&lt;p&gt;string&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Stick to String and &amp;amp;str for Unicode text. String 和&amp;amp;str为严格的Unicode字符串&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;When working with filenames, use std::path::PathBuf and &amp;amp;Path instead. 需要操作文件名时，使用std::path::PathBuf 和 &amp;amp;Path&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;When working with binary data that isn’t character data at all, use Vec&lt;u8&gt; and &amp;amp;[u8]. 二进制数据&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;When working with environment variable names and command-line arguments in the native form presented by the operating system, use OsString and &amp;amp;OsStr. 操作系统原生形式的化境变量和命令行参数， OsString and &amp;amp;OsStr&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;When interoperating with C libraries that use null-terminated strings, use std::ffi::CString and &amp;amp;CStr. 与C库互操作时，使用 std::ffi::CString and &amp;amp;CStr&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ul&gt;</description></item><item><title>类型</title><link>https://imhun.com/post/2017-12-15.rust-types/</link><pubDate>Fri, 15 Dec 2017 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2017-12-15.rust-types/</guid><description>&lt;p&gt;类型&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;Struct&lt;/p&gt;&#10;&lt;p&gt;Impl block 可以有多个，但必须在定义struct的crate中&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://doc.rust-lang.org/book/second-edition/ch19-03-advanced-traits.html#associated-types"&gt;Associated Types&lt;/a&gt;&lt;/p&gt;&#10;&lt;p&gt;关联类型&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://doc.rust-lang.org/book/second-edition/ch19-03-advanced-traits.html#operator-overloading-and-default-type-parameters"&gt;Operator Overloading and Default Type Parameters&lt;/a&gt;&lt;/p&gt;&#10;&lt;p&gt;默认类型参数&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;span class="lnt"&gt;2&#10;&lt;/span&gt;&lt;span class="lnt"&gt;3&#10;&lt;/span&gt;&lt;span class="lnt"&gt;4&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;trait&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;Add&lt;/span&gt;&lt;span class="o"&gt;&amp;lt;&lt;/span&gt;&lt;span class="no"&gt;RHS&lt;/span&gt;&lt;span class="o"&gt;=&lt;/span&gt;&lt;span class="bp"&gt;Self&lt;/span&gt;&lt;span class="o"&gt;&amp;gt;&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="p"&gt;{&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;type&lt;/span&gt; &lt;span class="nc"&gt;Output&lt;/span&gt;&lt;span class="p"&gt;;&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;fn&lt;/span&gt; &lt;span class="nf"&gt;add&lt;/span&gt;&lt;span class="p"&gt;(&lt;/span&gt;&lt;span class="bp"&gt;self&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="n"&gt;rhs&lt;/span&gt;: &lt;span class="nc"&gt;RHS&lt;/span&gt;&lt;span class="p"&gt;)&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;-&amp;gt; &lt;span class="nc"&gt;Self&lt;/span&gt;::&lt;span class="n"&gt;Output&lt;/span&gt;&lt;span class="p"&gt;;&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;}&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;2个主要的用法&lt;/p&gt;&#10;&lt;ol&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;To extend a type without breaking existing code.扩展类型而不破坏已有代码&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;To allow customization in a way most users don’t want.一种允许自定义的方式，大多数用户可能用不到&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ol&gt;</description></item><item><title>学习笔记</title><link>https://imhun.com/post/2017-12-12.rust-study-notes/</link><pubDate>Tue, 12 Dec 2017 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2017-12-12.rust-study-notes/</guid><description>&lt;p&gt;学习笔记&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;位运算符，优先级高于比较运算符&lt;/p&gt;&#10;&lt;p&gt;&amp;amp;,|,^,!,&amp;laquo;,&amp;raquo;&lt;/p&gt;&#10;&lt;p&gt;逻辑运算符&lt;/p&gt;&#10;&lt;p&gt;&amp;amp;&amp;amp;,|| ,操作数类型必须是bool&lt;/p&gt;&#10;&lt;p&gt;比较运算符&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;div class="chroma"&gt;&#10;&lt;table class="lntable"&gt;&lt;tr&gt;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code&gt;&lt;span class="lnt"&gt;1&#10;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#10;&lt;td class="lntd"&gt;&#10;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-rust" data-lang="rust"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="o"&gt;==&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;!=&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;&amp;lt;&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;&amp;lt;=&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;&amp;gt;&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="o"&gt;&amp;gt;=&lt;/span&gt;&lt;span class="w"&gt; &lt;/span&gt;&lt;span class="err"&gt;，操作数类型必须相同&lt;/span&gt;&lt;span class="w"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;&lt;p&gt;强制类型转换&lt;/p&gt;&#10;&lt;ol&gt;&#10;&lt;li&gt;数字类型之间可以任意转换&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;p&gt;转换到窄类型会直接截断&lt;/p&gt;</description></item><item><title>Rust 实例教程</title><link>https://imhun.com/post/2017-10-25.rust-tutorial/</link><pubDate>Wed, 25 Oct 2017 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2017-10-25.rust-tutorial/</guid><description>&lt;p&gt;Rust 实例教程&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;&lt;a href="https://3442853561.gitbooks.io/rustcasestudymanual/content/"&gt;https://3442853561.gitbooks.io/rustcasestudymanual/content/&lt;/a&gt;&lt;/p&gt;</description></item><item><title>容器指针</title><link>https://imhun.com/post/2017-10-25.rust-container-pointers/</link><pubDate>Wed, 25 Oct 2017 09:00:00 +0000</pubDate><guid>https://imhun.com/post/2017-10-25.rust-container-pointers/</guid><description>&lt;p&gt;容器指针&lt;/p&gt;&#10;&lt;!-- more --&gt;&#10;&lt;p&gt;&lt;img src="rust-container-pointers-01.png" alt=""&gt;&lt;/p&gt;&#10;&lt;p&gt;&lt;img src="rust-container-pointers-02.jpg" alt=""&gt;&lt;/p&gt;</description></item><item><title>rust练习之高阶过程</title><link>https://imhun.com/post/2016-01-27.rust-study1/</link><pubDate>Wed, 27 Jan 2016 08:58:02 +0000</pubDate><guid>https://imhun.com/post/2016-01-27.rust-study1/</guid><description>&lt;p&gt;在学习rust的过程中，了解了高阶函数的知识，说白了就是函数可以作为参数，也可以返回一个函数，正好最近看到了scip公开课里面讲高阶过程这一章，有个求平方根的过程，里面的lisp实现相当的简洁优美，基本是对数学公式的形式化书写。这里用rust实现一下，看看区别有多大。&#10;主要实现了传入函数作为参数，并将函数作为返回值，并以函数式风格实现了平方根求值。&lt;/p&gt;</description></item><item><title>rust常用类型转换</title><link>https://imhun.com/post/2015-12-30.rust-type-cast/</link><pubDate>Wed, 30 Dec 2015 08:58:02 +0000</pubDate><guid>https://imhun.com/post/2015-12-30.rust-type-cast/</guid><description>&lt;p&gt;常用原生类型转换，Vec类型转换&lt;/p&gt;&#10;&lt;table&gt;&#10;&#9;&lt;thead&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;x类型\至类型&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;i32&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;u32&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;f64&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;String&lt;/th&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/thead&gt;&#10;&#9;&lt;tbody&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;i32&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x as u32&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x as f64&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.to_string()&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;u32&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x as u32&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x as f64&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.to_string()&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;f64&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x as i32&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x as u32&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.to_string()&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;String*&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.parse().unwrap()&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.parse().unwrap()&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.parse().unwrap()&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&lt;!-- more --&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;*可以看到i32, u32, f64 到String类型是同一个函数，这样的话，如何来确定要转换至的具体类型？就是类型推导！当然，如果rust无法通过上下文推导出类型，就需要给出提示，例如x.parse::&lt;i32&gt;().unwrap()。但是通常情况下，都不需要提示即可自动推导出类型。&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;h4 id="strstringcollectionsstringstring"&gt;&amp;amp;str/String/collections::string::String&lt;/h4&gt;&#10;&lt;table&gt;&#10;&#9;&lt;thead&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;x类型\至类型&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;String&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;&amp;amp;str&lt;/th&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/thead&gt;&#10;&#9;&lt;tbody&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;String&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;&amp;amp;*x&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;&amp;amp;str&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.to_string()&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/tbody&gt;&#10;&lt;/table&gt;&#10;&lt;h4 id="vectboxt"&gt;Vec&lt;T&gt;/&amp;amp;[T]/Box&amp;lt;[T]&amp;gt;&lt;/h4&gt;&#10;&lt;table&gt;&#10;&#9;&lt;thead&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;x类型\至类型&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;Vec&lt;T&gt;&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;&amp;amp;[T]&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;Box&amp;lt;[T]&amp;gt;&lt;/th&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/thead&gt;&#10;&#9;&lt;tbody&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;Vec&lt;T&gt;&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;&amp;amp;x[..]&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.into_boxed_slice()&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;&amp;amp;[T]&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.to_vec()&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;Box::new(*x)&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;Box&amp;lt;[T]&amp;gt;&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;x.to_vec()&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;&amp;amp;*x&lt;/td&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;td&gt;n/a&lt;/td&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/tbody&gt;&#10;&lt;/table&gt;</description></item></channel></rss>